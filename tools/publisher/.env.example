SIYUAN_BASE_URL=http://127.0.0.1:6806
SIYUAN_TOKEN=
PUBLISH_REMOTE=origin
# Optional. By default the publisher pushes to the current branch upstream.
PUBLISH_BRANCH=
# Optional. Set to false on a server-led deployment host that should not push to GitHub.
PUBLISH_PUSH=true
# Optional. Only needed when you also want to notify an external platform such as Vercel.
PUBLISH_DEPLOY_HOOK=
