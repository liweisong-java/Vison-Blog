<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.weisong.backend.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.weisong.backend.entities.User">
        <id property="userUuid" column="user_uuid" jdbcType="VARCHAR"/>
        <result property="realName" column="real_name" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="password" column="password" jdbcType="VARCHAR"/>
        <result property="phone" column="phone" jdbcType="VARCHAR"/>
        <result property="qq" column="qq" jdbcType="INTEGER"/>
        <result property="email" column="email" jdbcType="VARCHAR"/>
        <result property="gender" column="gender" jdbcType="CHAR"/>
        <result property="birth" column="birth" jdbcType="VARCHAR"/>
        <result property="lastTime" column="last_time" jdbcType="VARCHAR"/>
        <result property="roleId" column="role_id" jdbcType="INTEGER"/>
<!--        头像-->
    </resultMap>

    <sql id="User_Column_List">
        `user_uuid`,
        `real_name`,
        `name`,
        `password`,
        `phone`,
        `qq`,
        `birth`,
        `email`,
        `gender`,
        `last_time`,
        `role_id`
    </sql>

    <insert id="insertUser">
        insert into user
        (<include refid="User_Column_List"/> )
         values
        (#{user_uuid},
        #{real_name},
        #{name},
        #{password},
        #{phone},
        #{qq},
        #{birth},
        #{email},
        #{gender},
        #{last_time},
        #{role_id})
    </insert>
    <update id="uploadHeadPortrait">
        UPDATE user SET head_portrait =#{headPortrait} WHERE user_uuid = #{user_uuid}
    </update>
    <delete id="deleteUserById">
        delete from user where user_uuid=#{user_uuid}
    </delete>
    <select id="checkName" resultType="java.lang.Integer">
        SELECT COUNT(`name`) from user where `name`= #{name}
    </select>
    <select id="findUserByNameOrEmail" resultType="com.weisong.backend.entities.User">
        SELECT
        <include refid="User_Column_List"/>
        from
        user
        where `name`=#{name} or `email`=#{email}
    </select>
    <select id="findUserByUuid" resultType="com.weisong.backend.entities.User">
        SELECT
        <include refid="User_Column_List"/>
        from
        user
        where user_uuid=#{user_uuid}
    </select>
</mapper>
