<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.weisong.backend.mapper.CommentMapper">

    <resultMap id="BaseResultMap" type="com.weisong.backend.entities.Comment">
            <result property="articleUuid" column="article_uuid" jdbcType="VARCHAR"/>
            <result property="userUuid" column="user_uuid" jdbcType="VARCHAR"/>
            <result property="comment" column="comment" jdbcType="VARCHAR"/>
            <result property="commentTime" column="comment_time" jdbcType="VARCHAR"/>
    </resultMap>
    <select id="getCommentByArticleUuid" resultType="com.weisong.backend.entities.Comment">
        select comment ,comment_time from comment c left join article a on a.article_uuid = c.article_uuid where c.article_uuid = #{article_uuid} order by comment_time desc
    </select>


</mapper>
