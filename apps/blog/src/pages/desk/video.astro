---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadPrivateDashboard, summarizeDeskStatus } from "../../lib/private-dashboard";

const data = await loadPrivateDashboard();
---

<BaseLayout
  title="视频转博客 | 个人中控台"
  description="个人中控台中的视频转博客工作区。"
  robots="noindex,nofollow,noarchive"
  showHeader={false}
  showFooter={false}
  mainClass="desk-shell"
  bodyClass="desk-body"
>
  <div class="desk-video-page">
    <section class="desk-hero desk-hero--compact">
      <div class="desk-hero__topline">
        <p class="desk-hero__eyebrow">Vison Desk</p>
        <span class="desk-hero__badge">Video</span>
      </div>
      <h1>视频转博客</h1>
      <p class="desk-hero__summary">优先尝试高质量字幕与转写链路生成博客；如果你已经整理好文本，也可以直接贴进来覆盖。</p>
    </section>

    <nav class="desk-inline-nav" aria-label="Desk navigation">
      <a href="/desk/">返回中控台</a>
      <a href="/secret-dashboard/">查看后台</a>
    </nav>

    <section class="desk-video-card">
      <div class="desk-video-card__header">
        <div>
          <p class="desk-video-card__label">Video To Blog</p>
          <h2>选择生成方式</h2>
        </div>
        <p class="desk-video-card__hint">默认就是自动模式，只贴链接也能开始；系统会优先走质量更高的转写链路，只有你想覆盖文字内容时，才切到手动文本模式。</p>
      </div>

      <label class="desk-field">
        <span>视频链接</span>
        <input
          class="desk-input"
          type="text"
          placeholder="粘贴视频链接"
          aria-label="粘贴视频链接"
          data-video-url
        />
      </label>

      <div class="desk-mode-switch" role="tablist" aria-label="生成方式">
        <button
          type="button"
          class="is-active"
          aria-pressed="true"
          data-video-mode-button
          data-mode-value="auto"
        >
          自动读取视频文字
        </button>
        <button
          type="button"
          aria-pressed="false"
          data-video-mode-button
          data-mode-value="manual"
        >
          使用我提供的文本
        </button>
      </div>

      <div class="desk-mode-panel" data-video-mode-panel="auto">
        <p><strong>自动模式：</strong> 你只需要贴链接。系统会先抓字幕，抓不到再下载音频并优先走高质量转写。</p>
      </div>

      <div class="desk-mode-panel" data-video-mode-panel="manual" hidden>
        <p><strong>手动模式：</strong> 适合你已经自己整理过文字，或者想精修表达时使用。提交后会直接按这份文本生成。</p>
      </div>

      <label class="desk-field" data-video-manual-field hidden>
        <span>视频文本</span>
        <textarea
          class="desk-input desk-input--multiline"
          placeholder="粘贴你整理好的视频文本"
          aria-label="人工 transcript"
          data-video-transcript
        ></textarea>
      </label>

      <div class="desk-video-notes" aria-label="使用说明">
        <p><strong>自动模式：</strong> 适合大多数情况，系统会优先使用质量更高的字幕和转写结果。</p>
        <p><strong>手动模式：</strong> 适合你已经整理好文稿，生成更快，也更可控。</p>
      </div>

      <div class="desk-video-actions">
        <button type="button" data-video-submit>生成博客</button>
        <button type="button" class="desk-button desk-button--secondary" data-video-refresh>刷新状态</button>
      </div>

      <div class="desk-inline-action" data-video-copy-wrap hidden>
        <button type="button" class="desk-button desk-button--ghost" data-video-copy>复制文本</button>
      </div>

      <p class="desk-video-feedback" data-video-feedback>默认是自动模式，只填链接就能开始。</p>
    </section>

    <section class="desk-command-list">
      <div class="desk-command-list__header">
        <div>
          <p class="desk-video-card__label">任务状态</p>
          <h2>最近任务</h2>
        </div>
      </div>
      <div class="desk-status-panel" data-video-status>
        <p>等待提交任务。</p>
      </div>
    </section>

    <section class="desk-status-hint" aria-label="当前状态">
      <p>{summarizeDeskStatus(data)}</p>
    </section>
  </div>

  <script is:inline>
    const apiBaseUrl = "/video-api";
    const urlInput = document.querySelector("[data-video-url]");
    const transcriptInput = document.querySelector("[data-video-transcript]");
    const submitButton = document.querySelector("[data-video-submit]");
    const copyButton = document.querySelector("[data-video-copy]");
    const copyWrap = document.querySelector("[data-video-copy-wrap]");
    const refreshButton = document.querySelector("[data-video-refresh]");
    const modeButtons = Array.from(document.querySelectorAll("[data-video-mode-button]"));
    const modePanels = Array.from(document.querySelectorAll("[data-video-mode-panel]"));
    const manualField = document.querySelector("[data-video-manual-field]");
    const feedback = document.querySelector("[data-video-feedback]");
    const statusPanel = document.querySelector("[data-video-status]");
    let currentMode = "auto";

    const setFeedback = (message) => {
      if (feedback instanceof HTMLElement) {
        feedback.textContent = message;
      }
    };

    const setStatus = (message) => {
      if (statusPanel instanceof HTMLElement) {
        statusPanel.innerHTML = `<p>${message}</p>`;
      }
    };

    const renderStatus = (payload) => {
      if (!(statusPanel instanceof HTMLElement)) {
        return;
      }

      const status = payload?.status ?? {};
      const lastResult = payload?.lastResult ?? null;
      const lastError = payload?.lastError ?? null;
      const running = Boolean(payload?.running);

      const rows = [
        `<div><span>队列总数</span><strong>${status.queueSize ?? 0}</strong></div>`,
        `<div><span>待处理</span><strong>${status.pending ?? 0}</strong></div>`,
        `<div><span>已发布</span><strong>${status.publishedVideos ?? 0}</strong></div>`
      ];

      const notes = [];
      if (running) {
        notes.push("<p>系统正在处理当前任务。</p>");
      }
      if (lastResult?.results?.length) {
        const latest = lastResult.results[0] ?? {};
        if (latest.slug) {
          notes.push(`<p>最近一次生成文章：<code>${latest.slug}</code></p>`);
        }
      }
      if (lastError) {
        notes.push(`<p>最近错误：${lastError}</p>`);
      }
      if (!notes.length) {
        notes.push("<p>最近没有新的处理结果。</p>");
      }

      statusPanel.innerHTML = `
        <div class="desk-status-grid">${rows.join("")}</div>
        <div class="desk-status-notes">${notes.join("")}</div>
      `;
    };

    const setMode = (mode) => {
      currentMode = mode === "manual" ? "manual" : "auto";

      modeButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) {
          return;
        }

        const active = button.dataset.modeValue === currentMode;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });

      modePanels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) {
          return;
        }

        panel.hidden = panel.dataset.videoModePanel !== currentMode;
      });

      if (manualField instanceof HTMLElement) {
        manualField.hidden = currentMode !== "manual";
      }

      if (copyWrap instanceof HTMLElement) {
        copyWrap.hidden = currentMode !== "manual";
      }
    };

    const fetchStatus = async () => {
      const response = await fetch(`${apiBaseUrl}/status`);
      if (!response.ok) {
        throw new Error("状态服务暂时不可用。");
      }

      const payload = await response.json();
      renderStatus(payload);
      return payload;
    };

    const copyTranscript = async () => {
      const transcript =
        transcriptInput instanceof HTMLTextAreaElement ? transcriptInput.value.trim() : "";

      if (currentMode !== "manual") {
        setFeedback("切到“使用我提供的文本”后，才需要复制这段内容。");
        return;
      }

      if (!transcript) {
        setFeedback("当前还没有可复制的文本。");
        return;
      }

      await navigator.clipboard.writeText(transcript);
      setFeedback("文本已复制，可以直接贴到别处继续使用。");
    };

    const submitTask = async () => {
      const url = urlInput instanceof HTMLInputElement ? urlInput.value.trim() : "";
      const transcript =
        transcriptInput instanceof HTMLTextAreaElement ? transcriptInput.value.trim() : "";

      if (!url) {
        setFeedback("先填入视频链接。");
        return;
      }

      const manualMode = currentMode === "manual";
      if (manualMode && !transcript) {
        setFeedback("你当前选的是手动文本模式，请先贴入视频文本。");
        return;
      }

      setFeedback(
        manualMode
          ? "任务已提交，正在根据你提供的文本生成博客。"
          : "任务已提交，正在自动提取视频文字并生成博客，请稍等。"
      );
      setStatus(
        manualMode
          ? "系统正在使用你提供的文本生成当前任务。"
          : "系统正在抓取字幕或转写音频，请稍等。"
      );

      const response = await fetch(`${apiBaseUrl}/submit`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(
          transcript
            ? {
                url,
                transcript
              }
            : {
                url
              }
        )
      });

      const payload = await response.json().catch(() => ({}));
      if (!response.ok || payload?.ok === false) {
        throw new Error(payload?.message ?? "提交失败，请检查 video-to-blog 服务。");
      }

      renderStatus(payload);
      const slug = payload?.result?.results?.[0]?.slug;
      setFeedback(slug ? `处理完成，文章已生成：${slug}` : "任务已处理完成。");
    };

    modeButtons.forEach((button) => {
      button?.addEventListener("click", () => {
        if (!(button instanceof HTMLButtonElement)) {
          return;
        }

        setMode(button.dataset.modeValue ?? "auto");
        setFeedback(
          button.dataset.modeValue === "manual"
            ? "当前是手动文本模式，提交时会优先使用你提供的文字。"
            : "当前是自动模式，只填链接就能开始。"
        );
      });
    });

    copyButton?.addEventListener("click", () => {
      void copyTranscript().catch((error) => {
        const message = error instanceof Error ? error.message : String(error);
        setFeedback(message);
      });
    });

    submitButton?.addEventListener("click", () => {
      void submitTask().catch((error) => {
        const message = error instanceof Error ? error.message : String(error);
        setFeedback(message);
        setStatus(message);
      });
    });

    refreshButton?.addEventListener("click", () => {
      void fetchStatus().catch((error) => {
        const message = error instanceof Error ? error.message : String(error);
        setFeedback(message);
      });
    });

    void fetchStatus().catch(() => {
      setStatus("还没有连上 video-to-blog 服务，请先启动服务。");
    });

    setMode("auto");
  </script>
</BaseLayout>
