---
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sortPublishedPosts } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.publish);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params as { tag: string };
const posts = sortPublishedPosts(await getCollection("posts", ({ data }) => data.publish)).filter((post) =>
  post.data.tags.includes(tag)
);
---

<BaseLayout title={`#${tag} | 伟松的博客`} description={`浏览与 ${tag} 相关的文章。`}>
  <section class="page-intro page-intro--compact">
    <p class="eyebrow">标签</p>
    <h1>#{tag}</h1>
    <p class="page-intro__summary">共 {posts.length} 篇</p>
  </section>
  <div class="post-list category-posts">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
