---
import { getCollection, render } from "astro:content";
import ArticleToc from "../../components/ArticleToc.astro";
import Comments from "../../components/Comments.astro";
import Callout from "../../components/mdx/Callout.astro";
import Columns from "../../components/mdx/Columns.astro";
import EmbedCard from "../../components/mdx/EmbedCard.astro";
import PostCard from "../../components/PostCard.astro";
import QuoteBlock from "../../components/mdx/QuoteBlock.astro";
import { siteConfig } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getArticleLead,
  getRelatedPosts,
  groupArticleHeadings,
  sortPublishedPosts
} from "../../lib/content";
import { formatDisplayDate, getCategoryLabel } from "../../lib/presenters";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.publish);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const allPosts = sortPublishedPosts(await getCollection("posts", ({ data }) => data.publish));
const { Content, headings } = await render(post);
const relatedPosts = getRelatedPosts(post, allPosts);
const categoryLabel = getCategoryLabel(post.data.category);
const articleLead = getArticleLead(post.data.excerpt, post.body);
const groupedHeadings = groupArticleHeadings(headings);
const hasRelatedPosts = relatedPosts.length > 0;
---

<BaseLayout
  title={`${post.data.title} | ${siteConfig.title}`}
  description={post.data.excerpt}
  ogType="article"
>
  <article class="article-shell">
    <header class="article-header">
      <div class="article-kicker">
        <span>{categoryLabel}</span>
        <span>{formatDisplayDate(post.data.publishedAt)}</span>
      </div>
      <h1>{post.data.title}</h1>
      {articleLead && <p class="article-summary">{articleLead}</p>}
    </header>
    {post.data.cover && (
      <div class="article-cover">
        <img src={post.data.cover} alt={post.data.title} loading="eager" />
      </div>
    )}
    <div class="article-grid">
      <div class="article-main">
        <ArticleToc headings={groupedHeadings} variant="mobile" />
        <div class="prose">
          <Content
            components={{
              Callout,
              QuoteBlock,
              EmbedCard,
              Columns
            }}
          />
        </div>
        {post.data.canonicalUrl && (
          <p class="article-source">
            原文链接：
            <a href={post.data.canonicalUrl} rel="noreferrer">
              {post.data.canonicalUrl}
            </a>
          </p>
        )}
      </div>
      <ArticleToc headings={groupedHeadings} variant="desktop" />
    </div>
    {hasRelatedPosts && (
      <section class="article-related">
        <h2>相关文章</h2>
        <div class="post-grid">
          {relatedPosts.map((relatedPost) => <PostCard post={relatedPost} />)}
        </div>
      </section>
    )}
    <Comments />
  </article>
</BaseLayout>
