---
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { filterPostsByCategory, sortPublishedPosts } from "../../lib/content";

export async function getStaticPaths() {
  return ["tech", "life"].map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: "tech" | "life" };
const posts = filterPostsByCategory(
  sortPublishedPosts(await getCollection("posts", ({ data }) => data.publish)),
  category
);
const label = category === "tech" ? "技术" : "生活";
---

<BaseLayout title={`${label} | 伟松的博客`} description={`${label}分类文章列表。`}>
  <div class="category-page">
    <section class="page-intro page-intro--compact">
      <h1>{label}</h1>
      <p class="post-meta">共 {posts.length} 篇</p>
    </section>

    <div class="post-list category-posts">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
