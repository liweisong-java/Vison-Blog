---
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return ["tech", "life"].map((category) => ({ params: { category } }));
}
---

<BaseLayout title="文章 | 伟松的博客" description="博客内容统一按时间流展示。">
  <div class="category-page">
    <section class="page-intro page-intro--compact">
      <h1>文章</h1>
      <p class="post-meta">内容入口已统一。</p>
    </section>

    <p class="page-intro__summary">
      这里不再单独分栏目展示，所有文章都会按统一内容流整理。你可以直接返回首页继续阅读。
    </p>

    <p class="post-meta">
      <a href="/">返回首页</a>
    </p>
  </div>
</BaseLayout>
