---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getArchiveGroups, sortPublishedPosts } from "../lib/content";
import { formatDisplayDate } from "../lib/presenters";

const posts = sortPublishedPosts(await getCollection("posts", ({ data }) => data.publish));
const groups = getArchiveGroups(posts);
const totalPosts = posts.length;
---

<BaseLayout title="归档 | 伟松的博客" description="按时间顺序浏览所有已发布文章。">
  <div class="archive-page">
    <section class="page-intro page-intro--compact" data-page-intro="archive">
      <h1>归档</h1>
      <p class="post-meta">共 {totalPosts} 篇</p>
    </section>

    <div class="archive-stack">
      {groups.map(([year, yearPosts]) => (
        <section class="archive-year">
          <div class="archive-year__header">
            <div class="archive-year__eyebrow">年份</div>
            <div class="archive-year__title-group">
              <h2>{year}</h2>
              <p>{yearPosts.length} 篇文章</p>
            </div>
          </div>
          <ul class="archive-list">
            {yearPosts.map((post) => (
              <li>
                <a href={`/posts/${post.data.slug}/`}>
                  <time datetime={post.data.publishedAt.toISOString()} class="archive-list__date">
                    {formatDisplayDate(post.data.publishedAt)}
                  </time>
                  <div class="archive-list__content">
                    <span>{post.data.title}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
