---
import { siteConfig } from "../data/site";
---

<header class="site-header">
  <a class="brand" href="/">{siteConfig.title}</a>
  <nav aria-label="Primary">
    <ul class="nav-list">
      {siteConfig.nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
