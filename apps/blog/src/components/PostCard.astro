---
import { formatDisplayDate } from "../lib/presenters";

const { post } = Astro.props;
---

<article
  class="post-card"
  data-search-card
  data-search-title={post.data.title.toLowerCase()}
  data-search-excerpt={post.data.title.toLowerCase()}
  data-search-tags={post.data.tags.join(" ").toLowerCase()}
>
  <a href={`/posts/${post.data.slug}/`} class="post-card-link">
    <div class="post-card-meta">
      <span class="post-meta">{formatDisplayDate(post.data.publishedAt)}</span>
    </div>
    <h3 class="post-card-title">{post.data.title}</h3>
  </a>
</article>
