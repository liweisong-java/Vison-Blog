<div class="category-filter" data-category-filter>
  <button type="button" data-filter="all" class="is-active">全部</button>
  <button type="button" data-filter="tech">技术</button>
  <button type="button" data-filter="life">生活</button>
</div>

<script>
  const root = document.querySelector("[data-category-filter]");
  const cards = [...document.querySelectorAll("[data-category]")];

  root?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLButtonElement)) return;

    const filter = target.dataset.filter ?? "all";
    root.querySelectorAll("button").forEach((button) => button.classList.remove("is-active"));
    target.classList.add("is-active");

    for (const card of cards) {
      const category = card.getAttribute("data-category");
      const shouldHideForCategory = filter !== "all" && category !== filter;
      card.toggleAttribute("hidden", shouldHideForCategory);
      card.setAttribute("data-filter-hidden", shouldHideForCategory ? "true" : "false");
    }
  });
</script>
